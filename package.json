{
  "name": "dsh-wechat-bg",
  "version": "1.1.0",
  "description": "Scan a QR code with WeChat, upload a photo from the phone, and use it as the DSH Web UI background · 微信扫码，手机上传照片，换成 DSH 的全屏背景",
  "type": "module",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "phone-page.js",
    "cordis.patch.yml",
    "vendor/qrcode.mjs",
    "vendor/NOTICE.md",
    "vendor/qrcode-generator-README.md",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "assets/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XinpengWei/dsh-wechat-bg.git"
  },
  "homepage": "https://github.com/XinpengWei/dsh-wechat-bg#readme",
  "bugs": {
    "url": "https://github.com/XinpengWei/dsh-wechat-bg/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "background",
    "wallpaper",
    "wechat",
    "qrcode"
  ]
}
